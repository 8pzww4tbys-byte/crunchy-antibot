# Server
PORT=8787
HOST=127.0.0.1
PUBLIC_ORIGIN=https://crunchy.2-26-84-26.sslip.io

# Comma-separated list. Include every origin that may call the API.
ALLOWED_ORIGINS=https://crunchy.2-26-84-26.sslip.io,http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:8123,http://localhost:8123,https://8pzww4tbys-byte.github.io

# Set to 1 only behind a trusted reverse proxy/CDN (Nginx, Cloudflare).
TRUST_PROXY=1

# Data and limits
DATA_DIR=server/data
FREE_LIMIT=10000

# Auth. Generate values with:
#   node -e "import('./server/auth.mjs').then(async a=>console.log(await a.hashPassword('replace-me')))"
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=30
# Comma-separated list of admin e-mails; the first one is used for logging.
ADMIN_EMAIL=admin@crunchy.2-26-84-26.sslip.io,admin@2-26-84-26.sslip.io
ADMIN_PASSWORD_HASH=
ADMIN_FAILURES=5
ADMIN_LOCK_MS=900000
SUPPORT_EMAIL=

# Application-layer protection. These are not a replacement for a CDN/WAF.
MAX_CONNECTIONS=512
MAX_CONNECTIONS_PER_IP=24
MAX_ACTIVE_REQUESTS=256
MAX_REQUESTS_PER_IP=12
MAX_BODY_BYTES=65536
MAX_HEADER_COUNT=80
HEADERS_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=20000
KEEP_ALIVE_TIMEOUT_MS=5000
RATE_WINDOW_MS=60000
RATE_LIMIT_STATIC=600
RATE_LIMIT_API=90
RATE_LIMIT_AUTH=12
RATE_LIMIT_SUPPORT=6
BAN_AFTER=900
BAN_MS=600000
