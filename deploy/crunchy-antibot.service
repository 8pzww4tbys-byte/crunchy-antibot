[Unit]
Description=crunchy antibot (free captcha service)
Documentation=https://github.com/8pzww4tbys-byte/crunchy-antibot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crunchy
Group=crunchy
WorkingDirectory=/opt/crunchy-antibot
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/crunchy-antibot/server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crunchy-antibot/server/data
UMask=0077

[Install]
WantedBy=multi-user.target
