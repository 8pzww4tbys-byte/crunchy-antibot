# crunchy antibot — small L3/L4 guard for HTTP(S).
#
# This is deliberately limited to TCP 80/443 and ICMP. It does not replace an
# upstream scrubbing/CDN: a link-saturating volumetric flood must be absorbed
# by the hosting provider or a service such as Cloudflare.
table inet crunchy_guard {
  chain input {
    type filter hook input priority -10; policy accept;

    iifname "lo" accept
    ct state established,related accept

    tcp dport { 80, 443 } ct state invalid counter drop

    # Per-source new-connection budget. Normal page loads use a handful of
    # connections; this drops SYN/connection floods from one address.
    tcp dport { 80, 443 } ct state new \
      meter new_http4 { ip saddr limit rate over 40/second burst 80 packets } \
      counter drop

    meta nfproto ipv6 tcp dport { 80, 443 } ct state new \
      meter new_http6 { ip6 saddr limit rate over 40/second burst 80 packets } \
      counter drop

    icmp type echo-request \
      meter ping4 { ip saddr limit rate over 20/second } \
      counter drop

    icmpv6 type echo-request \
      meter ping6 { ip6 saddr limit rate over 20/second } \
      counter drop
  }
}
