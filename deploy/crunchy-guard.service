[Unit]
Description=crunchy antibot nftables guard
Documentation=https://crunchy.2-26-84-26.sslip.io/
After=network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/crunchy-guard.nft
ExecReload=/usr/sbin/nft -f /etc/crunchy-guard.nft
ExecStop=-/usr/sbin/nft delete table inet crunchy_guard
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
